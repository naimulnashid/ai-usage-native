<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UsageCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default rate cards ship inside the library. A file of the same name
         in the config folder replaces one wholesale. -->
    <EmbeddedResource Include="Pricing\pricing.json" LogicalName="UsageCore.pricing.json" />
    <EmbeddedResource Include="Pricing\codex-pricing.json" LogicalName="UsageCore.codex-pricing.json" />
    <EmbeddedResource Include="Pricing\antigravity-pricing.json" LogicalName="UsageCore.antigravity-pricing.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Antigravity keeps its conversations in SQLite; nothing else reads it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsageCore.Tests" />
  </ItemGroup>
</Project>

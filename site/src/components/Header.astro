---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { LINKS } from '../lib/site';

const nav = [
  { href: '#features', label: 'Features' },
  { href: '#charts', label: 'Charts' },
  { href: '#pages', label: 'Pages' },
  { href: '#how', label: 'How it works' },
  { href: '#install', label: 'Install' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="AI Usage, back to top">
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span>AI Usage</span>
    </a>

    <div class="header-end">
      <nav class="nav-wide" aria-label="Main">
        <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
      </nav>
      <ThemeToggle />
      <a class="button button-secondary header-github" href={LINKS.repo}>
        <Icon name="github" />
        GitHub
      </a>
      <!-- Phones: a disclosure menu that works without JavaScript; the script
           only closes it after a link is chosen. -->
      <details class="nav-narrow">
        <summary aria-label="Menu">
          <Icon name="menu" class="icon-open" />
          <Icon name="close" class="icon-close" />
        </summary>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href={LINKS.repo}><Icon name="github" /> GitHub</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-narrow');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--topbar-bg);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--topbar-min-h);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Onyx: the product's name in Geist 600 at -0.02em, beside its own icon. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-wide {
    display: none;
    margin-right: 12px;
  }

  .nav-wide ul {
    display: flex;
    gap: 24px;
  }

  .nav-wide a {
    color: var(--text-dim);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .nav-wide a:hover {
    color: var(--text);
  }

  .header-github {
    display: none;
    min-height: 40px;
    padding: 8px 15px;
    font-size: 0.9375rem;
  }

  .nav-narrow summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    cursor: pointer;
    list-style: none;
  }

  .nav-narrow summary::-webkit-details-marker {
    display: none;
  }

  .nav-narrow summary :global(svg) {
    width: 20px;
    height: 20px;
  }

  .nav-narrow :global(.icon-close),
  .nav-narrow[open] :global(.icon-open) {
    display: none;
  }

  .nav-narrow[open] :global(.icon-close) {
    display: block;
  }

  .nav-narrow nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 6px var(--gutter) 18px;
    background: var(--canvas);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-pop);
  }

  .nav-narrow nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-narrow nav li:last-child a {
    border-bottom: 0;
  }

  .nav-narrow nav :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (min-width: 1000px) {
    .nav-wide,
    .header-github {
      display: inline-flex;
    }

    .nav-narrow {
      display: none;
    }
  }
</style>
